EXPO_PUBLIC_API_URL=http://192.168.68.55:8080/api/v1

# Sentry: error tracking. Vazio = desabilitado (desenvolvimento local).
# Em staging/production, configurar nos secrets do EAS:
#   eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value "https://..."
# EXPO_PUBLIC_SENTRY_ENVIRONMENT é definido automaticamente por eas.json (por perfil de build).
# Ver docs/observability.md para instruções completas.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development