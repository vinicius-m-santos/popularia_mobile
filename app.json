{
  "expo": {
    "name": "Popularia",
    "slug": "popularia_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "populariamobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/icon.png",
      "bundleIdentifier": "com.popularia.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECDD",
        "foregroundImage": "./assets/branding/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.popularia.mobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECDD",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1009324469949-a7n9k5v7ddbnf6vgk57nejesv67ij0h3"
        }
      ],
      [
        "@sentry/react-native",
        {
          "project": "popularia-mobile",
          "organization": "popularia",
          "deployGate": "always",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6e964283-951f-4a16-bf99-5a4d5236a338"
      }
    }
  }
}
