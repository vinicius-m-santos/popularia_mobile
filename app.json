{
  "expo": {
    "name": "Popularia",
    "slug": "popularia_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "populariamobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4ECDD",
        "foregroundImage": "./assets/branding/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECDD",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native",
        {
          "project": "popularia-mobile",
          "organization": "popularia",
          "deployGate": "always",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
